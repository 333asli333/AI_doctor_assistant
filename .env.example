# OpenRouter API anahtarı — https://openrouter.ai/keys adresinden alınır
OPENROUTER_API_KEY=

# Kullanılacak model (opsiyonel, varsayılan: google/gemini-2.0-flash-exp:free)
# Ücretsiz modelde günlük istek limiti var; limite takılırsanız ücretli ama
# çok ucuz olan google/gemini-2.5-flash modeline geçebilirsiniz.
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
