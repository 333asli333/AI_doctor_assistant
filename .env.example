# OpenRouter API anahtarı — https://openrouter.ai/keys adresinden alınır
OPENROUTER_API_KEY=

# Kullanılacak model (opsiyonel, varsayılan: google/gemini-2.5-flash)
# OpenRouter'da ücretsiz Gemini kalmadı. 2.5-flash milyon token başına ~0.30$;
# daha ucuzu google/gemini-2.5-flash-lite (~0.10$).
OPENROUTER_MODEL=google/gemini-2.5-flash
