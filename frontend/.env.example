# --- Derlemeye GÖMÜLEN ---
# Tarayıcının API'ye gideceği kök adres.
#   boş  -> aynı origin, göreli yollar (üretimde nginx /chat'i proxy'ler)
#   dolu -> ayrı alan adı, ör. https://doctor-assistant-api.aisli.dev
# Üretimde değer docker build arg'ı ile verilir (bkz. docker-compose.yml).
VITE_API_BASE=

# --- Yalnız `bun run dev` sunucusunu ayarlar, derlemeye girmez ---
VITE_DEV_PORT=5173
# VITE_API_BASE boşken /chat isteklerinin proxy'leneceği adres
VITE_API_PROXY=http://localhost:8000
