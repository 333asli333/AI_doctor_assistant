# --- Derlemeye GÖMÜLEN ---
# Tarayıcının API'ye gideceği kök adres.
#   boş  -> göreli yollar; YALNIZ `bun run dev` için (vite proxy'si /chat'i taşır)
#   dolu -> backend'in adresi, ör. https://doctor-assistant-api.aisli.dev
# Üretim nginx'i API'yi proxy'lemez, o yüzden docker derlemesinde dolu olmalı
# (bkz. Dockerfile ve docker-compose.yml).
VITE_API_BASE=

# --- Yalnız `bun run dev` sunucusunu ayarlar, derlemeye girmez ---
VITE_DEV_PORT=5173
# VITE_API_BASE boşken /chat isteklerinin proxy'leneceği adres
VITE_API_PROXY=http://localhost:8000
